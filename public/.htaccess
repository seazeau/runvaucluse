<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect www to non-www (matches all canonical tags)
  RewriteCond %{HTTP_HOST} ^www\.runvaucluse\.fr$ [NC]
  RewriteRule ^(.*)$ https://runvaucluse.fr/$1 [L,R=301]

  # Standard Next.js behavior for trailingSlash: true
  # If the file is not found, try to append .html or check for index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]

  # Redirect to index.html if it exists in the folder
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Handle 404 errors
  ErrorDocument 404 /404.html
</IfModule>
